# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# antigravity
.antigravityrules

# 특정 폴더 전체 제외
# 폴더명/

# 특정 폴더 안의 특정 하위 폴더만 제외
# 폴더명/제외할폴더/

# 루트 폴더의 특정 하위 폴더만 제외
# /제외할폴더/

# 폴더 안의 특정 파일만 남기고 싶을 때
# 폴더명/*
# !폴더명/제외할 파일명

# 특정 파일 제외
# 파일명
# !제외할 파일명